{
  "name": "@sakshamthakur/light-orm",
  "version": "0.1.0",
  "description": "A minimal, strongly typed TypeScript ORM for serverless PostgreSQL.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "keywords": ["orm", "postgres", "typescript", "serverless"],
  "publishConfig": {
    "access": "public"
  }
}
